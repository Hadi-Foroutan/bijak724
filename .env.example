APP_NAME=Laravel
APP_ENV=local
APP_KEY=base64:z/P86VxKjZ2ESOdLB5c19J/DdAkqXmYwUlS8qVKc33c=
APP_DEBUG=true
APP_URL=https://api.bijak724.ir

AUTH_GUARD=api
APP_LOCALE=fa
APP_FALLBACK_LOCALE=fa
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=daily
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=bijak
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=reverb
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

# Reverb (websocket): runs on the app domain itself with its own port (REVERB_HOST:REVERB_PORT),
# started on the server with `php artisan reverb:start`. Set the real domain in the server .env.
REVERB_APP_ID=local
REVERB_APP_KEY=local
REVERB_APP_SECRET=local
REVERB_HOST=localhost
# The server's own (internal) address; Apache proxies the public wss://REVERB_HOST:REVERB_PORT to it. Keep it on 127.0.0.1.
REVERB_SERVER_HOST=127.0.0.1
REVERB_SERVER_PORT=6001
# Optional, for the server: send events straight to the local Reverb (REVERB_SERVER_PORT) instead of through the public address.
# REVERB_PUBLISH_HOST=127.0.0.1
# REVERB_PUBLISH_PORT=8080
# REVERB_PUBLISH_SCHEME=http
# Sites allowed to connect (hosts only, comma separated). On the server set the frontend's domain, e.g. panel.bijak724.ir
REVERB_ALLOWED_ORIGINS=*
REVERB_PORT=443
REVERB_SCHEME=http

# true = the websocket (Reverb) server writes its start, connections, subscriptions and errors to storage/logs/socket_logs.log
SOCKET_LOGS=false

# Report exports (Excel/PDF) are only built by queue jobs, on two queues: light (up to REPORT_LIGHT_MAX_ROWS waybills; a worker
# that stays running takes them at once) and heavy (more; a cron job runs its worker every minute).
REPORT_QUEUE_LIGHT=reports-light
REPORT_QUEUE_HEAVY=reports-heavy
REPORT_LIGHT_MAX_ROWS=2000

VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST="${REVERB_HOST}"
VITE_REVERB_PORT="${REVERB_PORT}"
VITE_REVERB_SCHEME="${REVERB_SCHEME}"

CACHE_STORE=database
# CACHE_PREFIX=
# false = the dashboard always reads the database (no cache)
DASHBOARD_CACHE=true
DASHBOARD_CACHE_TTL_SECONDS=7200

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

DB_BACKUP_KEEP_DAYS=14
DB_BACKUP_DAILY_AT=02:00

# true = every cron run, artisan command and queue job writes its own log (storage/logs/cron, commands, jobs)
CRON_LOGS=false

# Sms Panel
SMS_DRIVER=panel
SMS_PANEL_URL=https://main.peykad.ir/api
SMS_PANEL_ENDPOINT=/api/apis/messages/send
SMS_PANEL_LINE=1000002121
SMS_WALLET_ENDPOINT=
# Registering a company's panel: the key is the application's own, not a user's
PANEL_REGISTRATION_ENDPOINT=/apis/user/register
USER_REGISTRATION_API_KEY=
PANEL_REGISTRATION_TYPE=legal
